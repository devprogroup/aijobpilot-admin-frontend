[Unit]
Description=AIJobPilot Admin Frontend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/aijobpilot/admin-frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run preview -- --host 127.0.0.1 --port 4174 --strictPort
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
